<Window x:Class="SignalCraftApp.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки" Height="230" Width="500" ResizeMode="NoResize" Icon="/Resources/Logo.jpg">
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Margin="10">
            <TextBlock Text="Arduino IDE Path:" Margin="5,5,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBox Name="TBArduinoPath" Width="350"/>
                <Button Content="Browse..." Click="BtnBrowseArduino_Click" Width="100"/>
            </StackPanel>

            <TextBlock Text="Quartus IDE Path:" Margin="5,5,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBox Name="TBQuartusPath" Width="350"/>
                <Button Content="Browse..." Click="BtnBrowseQuartus_Click" Width="100"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Отмена" Click="BtnCancel_Click" Width="225"/>
                <Button Content="Сохранить" FontWeight="Bold" Click="BtnSave_Click" Width="225"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>